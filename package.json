{
  "name": "wardrobe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test src/domain.test.ts src/auth.test.ts tests/database.test.mjs",
    "format": "prettier --write src tests README.md docs/*.md package.json tsconfig.json index.html",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/libre-caslon-display": "5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "31.0.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
